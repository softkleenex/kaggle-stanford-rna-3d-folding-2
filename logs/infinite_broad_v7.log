        stacked = np.stack(combined[:N_SAMPLE], axis=0)
        all_rows.extend(coords_to_rows(tid, seq, stacked))
"""

phase3_new = """
        if n_denovo:
            print(f"  {tid}: {n_denovo} slot(s) filled with de-novo fallback")

        # Apply physics-inspired chain geometry to all predictions
        for pi in range(len(combined)):
            combined[pi] = apply_chain_geometry(combined[pi])

        # Stack to (N_SAMPLE, seq_len, 3) and write rows
        stacked = np.stack(combined[:N_SAMPLE], axis=0)
        all_rows.extend(coords_to_rows(tid, seq, stacked))
"""

code = code.replace(phase3_old.strip(), phase3_new.strip())

with open("notebooks/script_v39.py", "w") as f:
